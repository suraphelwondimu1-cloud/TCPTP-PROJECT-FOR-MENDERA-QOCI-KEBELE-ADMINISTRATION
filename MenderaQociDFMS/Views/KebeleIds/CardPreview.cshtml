@model MenderaQociDFMS.Models.KebeleIdRecord
@{
    ViewData["Title"] = $"Kebele ID Card Preview - {Model.IdNumber}";
    var resident = Model.Resident;
    var photoUrl = !string.IsNullOrEmpty(resident?.PhotoPath) ? resident.PhotoPath : null;
    var qrText = $"{Model.IdNumber}|{resident?.FullName}|{resident?.SubKebele?.SubKebeleName}|EXP:{Model.ExpiryDate:yyyy-MM-dd}";
}

<!-- Action Toolbar (Hidden when printing) -->
<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 pb-2 border-bottom no-print">
    <div class="mb-2 mb-md-0">
        <h4 class="fw-bold text-success mb-1">
            <i class="bi bi-person-badge me-2"></i>Kebele ID Card Preview & Production
        </h4>
        <span class="text-muted small">
            Resident: <strong>@resident?.FullName</strong> | ID: <strong>@Model.IdNumber</strong> | Status:
            @if (Model.IdStatus == "Active" && Model.ExpiryDate >= DateTime.Now)
            {
                <span class="badge bg-success">Active</span>
            }
            else
            {
                <span class="badge bg-warning text-dark">@Model.IdStatus</span>
            }
        </span>
    </div>
    <div class="d-flex flex-wrap gap-2">
        <a asp-controller="Residents" asp-action="Details" asp-route-id="@Model.ResidentId" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-arrow-left me-1"></i> Back to Resident
        </a>
        <a asp-controller="Residents" asp-action="Edit" asp-route-id="@Model.ResidentId" class="btn btn-outline-primary btn-sm">
            <i class="bi bi-camera me-1"></i> Update / Retake Photo
        </a>
        <div class="btn-group btn-group-sm">
            <button type="button" class="btn btn-outline-success dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">
                <i class="bi bi-download me-1"></i> Download
            </button>
            <ul class="dropdown-menu dropdown-menu-end shadow">
                <li><a class="dropdown-item" href="#" id="btnDownloadFrontPng"><i class="bi bi-file-earmark-image me-2 text-primary"></i>Front Side (PNG)</a></li>
                <li><a class="dropdown-item" href="#" id="btnDownloadBackPng"><i class="bi bi-file-earmark-image me-2 text-primary"></i>Back Side (PNG)</a></li>
                <li><hr class="dropdown-divider"></li>
                <li><a class="dropdown-item" href="#" id="btnDownloadPdf"><i class="bi bi-file-earmark-pdf me-2 text-danger"></i>Print-Ready PDF (Both Sides)</a></li>
            </ul>
        </div>
        <button type="button" onclick="window.print()" class="btn btn-dark btn-sm fw-semibold">
            <i class="bi bi-printer me-1"></i> Print ID Card
        </button>
    </div>
</div>

<!-- Controls for view mode & card size configuration (Hidden when printing) -->
<div class="card bg-light border-0 shadow-sm mb-4 no-print">
    <div class="card-body py-2 px-3 d-flex flex-wrap align-items-center justify-content-between gap-3">
        <!-- View Side Selector -->
        <div class="d-flex align-items-center gap-2">
            <span class="small fw-semibold text-muted">Preview Side:</span>
            <div class="btn-group btn-group-sm" role="group">
                <button type="button" class="btn btn-outline-secondary active" id="viewBothBtn" onclick="setViewMode('both')">Both Sides</button>
                <button type="button" class="btn btn-outline-secondary" id="viewFrontBtn" onclick="setViewMode('front')">Front Only</button>
                <button type="button" class="btn btn-outline-secondary" id="viewBackBtn" onclick="setViewMode('back')">Back Only</button>
            </div>
        </div>

        <!-- Size / Dimensions Guide -->
        <div class="d-flex align-items-center gap-3">
            <span class="small text-muted">
                <i class="bi bi-aspect-ratio me-1"></i>Standard ID-1 Format: <strong>85.6mm &times; 53.98mm</strong> (3.37" &times; 2.125")
            </span>
            <span class="badge bg-white text-dark border">
                <i class="bi bi-shield-check text-success me-1"></i>Official Mendera Qoci Layout
            </span>
        </div>
    </div>
</div>

<!-- Print instructions alert (Hidden when printing) -->
<div class="alert alert-info py-2 small d-flex align-items-center justify-content-between no-print mb-4">
    <div>
        <i class="bi bi-info-circle-fill me-2"></i>
        <strong>Printing Tip:</strong> In your browser's Print dialog, choose <em>Margins: None</em> or <em>Default</em> and ensure <em>Background Graphics</em> is checked. For card printers or duplex paper, use both sides.
    </div>
    <span class="badge bg-info text-dark">Duplex Compatible</span>
</div>

<!-- ================= ID CARD RENDER CONTAINER ================= -->
<div class="id-cards-wrapper d-flex flex-wrap justify-content-center align-items-center gap-4 py-3">

    <!-- FRONT SIDE OF ID CARD -->
    <div class="id-card-outer" id="idCardFront">
        <div class="id-card-inner front-side">
            <!-- Header bar with Kebele Emblem & Title -->
            <div class="id-header">
                <div class="id-emblem">
                    <img src="~/images/kebele-seal.svg" alt="Seal" />
                </div>
                <div class="id-header-text">
                    <div class="amharic-title">መንደራ ቆጪ ቀበሌ አስተዳደር ጽ/ቤት</div>
                    <div class="primary-title">MENDERA QOCI KEBELE ADMINISTRATION</div>
                    <div class="sub-title">Jimma City Administration &bull; Oromia Region &bull; Ethiopia</div>
                    <div class="card-badge-title">RESIDENT IDENTIFICATION CARD</div>
                </div>
            </div>

            <!-- Card Body Content -->
            <div class="id-body">
                <!-- Resident Photo Column -->
                <div class="id-photo-col">
                    <div class="id-photo-frame">
                        @if (!string.IsNullOrEmpty(photoUrl))
                        {
                            <img src="@photoUrl" alt="@resident?.FullName" id="cardPhotoImg" crossorigin="anonymous" />
                        }
                        else
                        {
                            <div class="id-photo-placeholder">
                                <i class="bi bi-person"></i>
                                <span>NO PHOTO</span>
                            </div>
                        }
                    </div>
                    <div class="id-badge-code">MQ-KEBELE</div>
                </div>

                <!-- Demographics & ID Details Column -->
                <div class="id-info-col">
                    <div class="info-row">
                        <div class="info-label">FULL NAME / ሙሉ ስም</div>
                        <div class="info-value text-uppercase fw-bold text-success">@resident?.FullName</div>
                    </div>

                    <div class="info-grid-2">
                        <div class="info-row">
                            <div class="info-label">DATE OF BIRTH / የትውልድ ቀን</div>
                            <div class="info-value">@resident?.DateOfBirth.ToString("dd/MM/yyyy")</div>
                        </div>
                        <div class="info-row">
                            <div class="info-label">SEX / ጾታ</div>
                            <div class="info-value">@resident?.Gender</div>
                        </div>
                    </div>

                    <div class="info-grid-2">
                        <div class="info-row">
                            <div class="info-label">SUB-KEBELE / የሰፈር ቀጠና</div>
                            <div class="info-value">@(resident?.SubKebele?.SubKebeleName ?? "Central")</div>
                        </div>
                        <div class="info-row">
                            <div class="info-label">RESIDENT NO / ነዋሪ ቁጥር</div>
                            <div class="info-value font-monospace">#@resident?.ResidentId</div>
                        </div>
                    </div>

                    <div class="id-number-highlight">
                        <span class="id-num-lbl">KEBELE ID NO:</span>
                        <span class="id-num-val">@Model.IdNumber</span>
                    </div>
                </div>
            </div>

            <!-- Footer Bar with Dates & Watermark -->
            <div class="id-footer">
                <div class="footer-meta">
                    <span><strong>Issued:</strong> @Model.IssueDate.ToString("yyyy-MM-dd")</span>
                    <span>&bull;</span>
                    <span><strong>Expires:</strong> @Model.ExpiryDate.ToString("yyyy-MM-dd")</span>
                </div>
                <div class="footer-seal">OFFICIAL RESIDENT CARD</div>
            </div>
        </div>
    </div>

    <!-- BACK SIDE OF ID CARD -->
    <div class="id-card-outer" id="idCardBack">
        <div class="id-card-inner back-side">
            <!-- Header bar for Back -->
            <div class="back-header">
                <span class="back-header-text">MENDERA QOCI KEBELE &bull; RESIDENT RECORD & VERIFICATION</span>
            </div>

            <!-- Back Body Content -->
            <div class="back-body">
                <div class="back-left-col">
                    <div class="back-field">
                        <span class="b-lbl">Emergency / Phone:</span>
                        <span class="b-val">@(resident?.PhoneNumber ?? "None Listed")</span>
                    </div>
                    <div class="back-field">
                        <span class="b-lbl">Household Head:</span>
                        <span class="b-val">@(resident?.HouseholdHead ?? resident?.FullName)</span>
                    </div>
                    <div class="back-field">
                        <span class="b-lbl">Registration Date:</span>
                        <span class="b-val">@resident?.RegistrationDate.ToString("yyyy-MM-dd")</span>
                    </div>
                    <div class="back-field">
                        <span class="b-lbl">Issued By Officer:</span>
                        <span class="b-val">@(Model.IssuedByUser?.FullName ?? "Kebele Records Officer")</span>
                    </div>

                    <!-- Terms & Conditions Statement -->
                    <div class="back-notice">
                        <strong>Notice:</strong> This identification card remains the official property of Mendera Qoci Kebele Administration. It certifies legal local residency. If found, return to Mendera Qoci Kebele Administrative Office, Jimma.
                    </div>
                </div>

                <!-- Back Right Column (QR & Signature) -->
                <div class="back-right-col">
                    <div class="qr-container">
                        <!-- Canvas / SVG placeholder rendered with JS -->
                        <div id="qrCodeContainer" class="qr-box"></div>
                        <span class="qr-subtext">Scan to Verify</span>
                    </div>
                    <div class="signature-box">
                        <div class="sig-line"></div>
                        <span class="sig-caption">Authorized Official Signature & Seal</span>
                    </div>
                </div>
            </div>

            <!-- Machine Readable Zone (MRZ) Simulation for Card Authenticity -->
            <div class="back-mrz">
                <div class="mrz-line">IDETH<<@Model.IdNumber.Replace("-", "<")<<<<<<<<<<<<<<<<<<</div>
                <div class="mrz-line">@(resident?.ResidentId.ToString("D8"))<ETH<<@(resident?.DateOfBirth.ToString("yyMMdd"))<@(resident?.Gender.StartsWith("F", StringComparison.OrdinalIgnoreCase) == true ? "F" : "M")<@(Model.ExpiryDate.ToString("yyMMdd"))<<<<<<</div>
            </div>
        </div>
    </div>

</div>

<!-- Stylesheet specific to ID Card Layout, Display, and Print Dimensions -->
<style>
    /* Card Container Wrapper */
    .id-cards-wrapper {
        min-height: 400px;
    }

    /* Standard ID-1 Ratio Container (85.6mm x 53.98mm approx 1.586 aspect ratio) */
    .id-card-outer {
        width: 480px;
        height: 304px;
        box-shadow: 0 10px 25px rgba(0,0,0,0.15);
        border-radius: 12px;
        overflow: hidden;
        background: #ffffff;
        position: relative;
        box-sizing: border-box;
        border: 1px solid #dcdcdc;
        page-break-inside: avoid;
    }

    .id-card-inner {
        width: 100%;
        height: 100%;
        box-sizing: border-box;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        position: relative;
        background: #ffffff;
    }

    /* Subtle Guilloche / Pattern Background for Kebele Security Aesthetic */
    .front-side {
        background: linear-gradient(135deg, rgba(232, 245, 233, 0.45) 0%, rgba(255, 255, 255, 0.95) 50%, rgba(254, 249, 231, 0.45) 100%),
                    radial-gradient(circle at 75% 25%, rgba(46, 125, 50, 0.08) 0%, transparent 60%);
        border: 2px solid #2e7d32;
        border-radius: 12px;
    }

    .back-side {
        background: linear-gradient(135deg, rgba(245, 245, 245, 0.9) 0%, rgba(255, 255, 255, 0.95) 100%),
                    radial-gradient(circle at 25% 75%, rgba(46, 125, 50, 0.05) 0%, transparent 50%);
        border: 2px solid #616161;
        border-radius: 12px;
    }

    /* Front Header */
    .id-header {
        background: linear-gradient(90deg, #1b5e20 0%, #2e7d32 100%);
        color: #ffffff;
        padding: 6px 12px;
        display: flex;
        align-items: center;
        gap: 10px;
        border-bottom: 2px solid #fbc02d;
    }

    .id-emblem img {
        width: 42px;
        height: 42px;
        filter: drop-shadow(0 2px 4px rgba(0,0,0,0.25));
    }

    .id-header-text {
        flex: 1;
        line-height: 1.15;
    }

    .amharic-title {
        font-size: 11px;
        font-weight: 700;
        color: #fbc02d;
        letter-spacing: 0.5px;
    }

    .primary-title {
        font-size: 12px;
        font-weight: 800;
        letter-spacing: 0.5px;
    }

    .sub-title {
        font-size: 8.5px;
        color: rgba(255, 255, 255, 0.9);
    }

    .card-badge-title {
        font-size: 9px;
        font-weight: 700;
        color: #fff;
        background: rgba(0, 0, 0, 0.25);
        display: inline-block;
        padding: 1px 6px;
        border-radius: 3px;
        margin-top: 2px;
        letter-spacing: 0.5px;
    }

    /* Front Body */
    .id-body {
        padding: 8px 12px;
        display: flex;
        gap: 12px;
        flex: 1;
    }

    .id-photo-col {
        width: 105px;
        display: flex;
        flex-direction: column;
        align-items: center;
    }

    .id-photo-frame {
        width: 102px;
        height: 128px;
        border: 2px solid #2e7d32;
        border-radius: 6px;
        overflow: hidden;
        background: #f1f1f1;
        box-shadow: 0 2px 5px rgba(0,0,0,0.12);
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .id-photo-frame img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .id-photo-placeholder {
        text-align: center;
        color: #888;
    }

    .id-photo-placeholder i {
        font-size: 36px;
        display: block;
    }

    .id-photo-placeholder span {
        font-size: 9px;
        font-weight: bold;
    }

    .id-badge-code {
        font-size: 8px;
        font-weight: 800;
        color: #1b5e20;
        letter-spacing: 1px;
        margin-top: 4px;
        background: #e8f5e9;
        padding: 1px 6px;
        border-radius: 4px;
        border: 1px solid #c8e6c9;
    }

    .id-info-col {
        flex: 1;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
    }

    .info-row {
        margin-bottom: 3px;
    }

    .info-label {
        font-size: 8px;
        color: #666;
        text-transform: uppercase;
        letter-spacing: 0.3px;
        line-height: 1;
    }

    .info-value {
        font-size: 11px;
        font-weight: 600;
        color: #111;
        line-height: 1.2;
    }

    .info-grid-2 {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 6px;
    }

    .id-number-highlight {
        background: #f1f8e9;
        border: 1px dashed #2e7d32;
        padding: 3px 8px;
        border-radius: 4px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-top: 2px;
    }

    .id-num-lbl {
        font-size: 9px;
        font-weight: 700;
        color: #1b5e20;
    }

    .id-num-val {
        font-size: 12px;
        font-weight: 800;
        color: #1b5e20;
        font-family: monospace;
    }

    /* Front Footer */
    .id-footer {
        background: #e8f5e9;
        border-top: 1px solid #c8e6c9;
        padding: 3px 12px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        font-size: 9px;
        color: #2e7d32;
    }

    .footer-meta {
        font-size: 9px;
    }

    .footer-seal {
        font-weight: 700;
        letter-spacing: 0.5px;
        font-size: 8px;
    }

    /* Back Side Styles */
    .back-header {
        background: #37474f;
        color: #fff;
        padding: 5px 12px;
        font-size: 9px;
        font-weight: 700;
        letter-spacing: 0.5px;
        text-align: center;
        border-bottom: 2px solid #78909c;
    }

    .back-body {
        padding: 8px 12px;
        display: flex;
        gap: 12px;
        flex: 1;
    }

    .back-left-col {
        flex: 1.4;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
    }

    .back-field {
        margin-bottom: 2px;
    }

    .b-lbl {
        font-size: 8.5px;
        color: #555;
        font-weight: 600;
        display: inline-block;
        width: 105px;
    }

    .b-val {
        font-size: 9.5px;
        font-weight: 600;
        color: #111;
    }

    .back-notice {
        font-size: 7.5px;
        color: #555;
        line-height: 1.25;
        background: #f5f5f5;
        padding: 4px 6px;
        border-radius: 4px;
        border-left: 2px solid #37474f;
        margin-top: 2px;
    }

    .back-right-col {
        flex: 0.9;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: space-between;
    }

    .qr-container {
        text-align: center;
    }

    .qr-box {
        width: 82px;
        height: 82px;
        background: #fff;
        border: 1px solid #ccc;
        padding: 2px;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .qr-subtext {
        font-size: 7.5px;
        color: #666;
        display: block;
        margin-top: 1px;
    }

    .signature-box {
        text-align: center;
        width: 100%;
    }

    .sig-line {
        border-bottom: 1px dashed #444;
        margin-bottom: 2px;
        height: 16px;
    }

    .sig-caption {
        font-size: 7px;
        color: #666;
        text-transform: uppercase;
        display: block;
    }

    /* Machine Readable Zone */
    .back-mrz {
        background: #f0f0f0;
        border-top: 1px solid #ccc;
        padding: 4px 10px;
        font-family: 'OCR-B', 'Consolas', 'Courier New', monospace;
        font-size: 9px;
        line-height: 1.2;
        letter-spacing: 1.5px;
        color: #111;
        font-weight: 700;
    }

    .mrz-line {
        white-space: nowrap;
        overflow: hidden;
    }

    /* Print Specific Media Styling - Strict ID card dimensions */
    @@media print {
        body {
            background-color: #ffffff !important;
            margin: 0 !important;
            padding: 0 !important;
        }

        .no-print, header, footer, nav {
            display: none !important;
        }

        .container-fluid {
            padding: 0 !important;
            margin: 0 !important;
        }

        .id-cards-wrapper {
            display: flex !important;
            flex-direction: row !important;
            justify-content: flex-start !important;
            align-items: flex-start !important;
            gap: 15mm !important;
            padding: 10mm !important;
        }

        /* Physical ISO/IEC 7810 ID-1 standard dimensions: 85.60 mm x 53.98 mm */
        .id-card-outer {
            width: 85.6mm !important;
            height: 53.98mm !important;
            border-radius: 3.18mm !important;
            box-shadow: none !important;
            border: 0.5pt solid #999 !important;
            margin: 0 !important;
            -webkit-print-color-adjust: exact !important;
            print-color-adjust: exact !important;
            break-inside: avoid !important;
            page-break-inside: avoid !important;
        }

        .id-header {
            padding: 1.5mm 2.5mm !important;
            gap: 2mm !important;
        }

        .id-emblem img {
            width: 8.5mm !important;
            height: 8.5mm !important;
        }

        .amharic-title {
            font-size: 6.5pt !important;
        }

        .primary-title {
            font-size: 7pt !important;
        }

        .sub-title {
            font-size: 5pt !important;
        }

        .card-badge-title {
            font-size: 5.5pt !important;
            padding: 0.2mm 1mm !important;
        }

        .id-body {
            padding: 1.5mm 2.5mm !important;
            gap: 2.5mm !important;
        }

        .id-photo-col {
            width: 20mm !important;
        }

        .id-photo-frame {
            width: 20mm !important;
            height: 25mm !important;
        }

        .id-badge-code {
            font-size: 4.5pt !important;
        }

        .info-label {
            font-size: 4.5pt !important;
        }

        .info-value {
            font-size: 6.5pt !important;
        }

        .id-num-lbl {
            font-size: 5.5pt !important;
        }

        .id-num-val {
            font-size: 7.5pt !important;
        }

        .id-footer {
            padding: 1mm 2.5mm !important;
            font-size: 5.5pt !important;
        }

        .footer-seal {
            font-size: 5pt !important;
        }

        /* Back side print adjustments */
        .back-header {
            padding: 1.2mm 2.5mm !important;
            font-size: 5.5pt !important;
        }

        .back-body {
            padding: 1.5mm 2.5mm !important;
            gap: 2mm !important;
        }

        .b-lbl {
            font-size: 5pt !important;
            width: 18mm !important;
        }

        .b-val {
            font-size: 5.5pt !important;
        }

        .back-notice {
            font-size: 4.5pt !important;
            padding: 0.8mm !important;
        }

        .qr-box {
            width: 16mm !important;
            height: 16mm !important;
        }

        .qr-subtext {
            font-size: 4pt !important;
        }

        .sig-caption {
            font-size: 4pt !important;
        }

        .back-mrz {
            padding: 1mm 2mm !important;
            font-size: 5.5pt !important;
            letter-spacing: 0.8pt !important;
        }
    }
</style>

@section Scripts {
    <!-- QR Code Generator & HTML2Canvas & jsPDF Libraries via CDN -->
    <script src="https://cdn.jsdelivr.net/npm/qrcodejs@1.0.0/qrcode.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/html2canvas@1.4.1/dist/html2canvas.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/jspdf@2.5.1/dist/jspdf.umd.min.js"></script>

    <script>
        // 1. Generate QR Code on Card Back
        const qrContainer = document.getElementById("qrCodeContainer");
        const qrPayload = "@Html.Raw(qrText)";
        try {
            new QRCode(qrContainer, {
                text: qrPayload,
                width: 76,
                height: 76,
                colorDark: "#111111",
                colorLight: "#ffffff",
                correctLevel: QRCode.CorrectLevel.M
            });
        } catch (e) {
            console.error("QR Code error:", e);
            qrContainer.innerText = "QR Code";
        }

        // 2. View Mode Switcher (Both, Front Only, Back Only)
        function setViewMode(mode) {
            const frontCard = document.getElementById("idCardFront");
            const backCard = document.getElementById("idCardBack");

            document.getElementById("viewBothBtn").classList.remove("active");
            document.getElementById("viewFrontBtn").classList.remove("active");
            document.getElementById("viewBackBtn").classList.remove("active");

            if (mode === "front") {
                frontCard.style.display = "block";
                backCard.style.display = "none";
                document.getElementById("viewFrontBtn").classList.add("active");
            } else if (mode === "back") {
                frontCard.style.display = "none";
                backCard.style.display = "block";
                document.getElementById("viewBackBtn").classList.add("active");
            } else {
                frontCard.style.display = "block";
                backCard.style.display = "block";
                document.getElementById("viewBothBtn").classList.add("active");
            }
        }

        // Helper: Capture element to Canvas
        async function captureCard(element) {
            return await html2canvas(element, {
                scale: 3, // High DPI render
                useCORS: true,
                allowTaint: true,
                backgroundColor: "#ffffff",
                logging: false
            });
        }

        // Helper: Download Canvas as PNG
        function triggerDownload(dataUrl, filename) {
            const link = document.createElement("a");
            link.download = filename;
            link.href = dataUrl;
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);
        }

        // 3. Download Front Side as PNG
        document.getElementById("btnDownloadFrontPng").addEventListener("click", async function(e) {
            e.preventDefault();
            const card = document.getElementById("idCardFront");
            const wasHidden = card.style.display === "none";
            if (wasHidden) card.style.display = "block";

            try {
                const canvas = await captureCard(card);
                const dataUrl = canvas.toDataURL("image/png");
                triggerDownload(dataUrl, `Kebele_ID_Front_@Model.IdNumber.Replace("/", "_")` + ".png");
            } catch (err) {
                alert("Failed to render front card: " + err.message);
            } finally {
                if (wasHidden) card.style.display = "none";
            }
        });

        // 4. Download Back Side as PNG
        document.getElementById("btnDownloadBackPng").addEventListener("click", async function(e) {
            e.preventDefault();
            const card = document.getElementById("idCardBack");
            const wasHidden = card.style.display === "none";
            if (wasHidden) card.style.display = "block";

            try {
                const canvas = await captureCard(card);
                const dataUrl = canvas.toDataURL("image/png");
                triggerDownload(dataUrl, `Kebele_ID_Back_@Model.IdNumber.Replace("/", "_")` + ".png");
            } catch (err) {
                alert("Failed to render back card: " + err.message);
            } finally {
                if (wasHidden) card.style.display = "none";
            }
        });

        // 5. Download Both Sides as Print-Ready PDF
        document.getElementById("btnDownloadPdf").addEventListener("click", async function(e) {
            e.preventDefault();
            const frontCard = document.getElementById("idCardFront");
            const backCard = document.getElementById("idCardBack");

            const frontWasHidden = frontCard.style.display === "none";
            const backWasHidden = backCard.style.display === "none";
            frontCard.style.display = "block";
            backCard.style.display = "block";

            try {
                // ISO ID-1 card dimensions in mm: 85.60 x 53.98
                const cardWidthMm = 85.6;
                const cardHeightMm = 53.98;

                const frontCanvas = await captureCard(frontCard);
                const backCanvas = await captureCard(backCard);

                const { jsPDF } = window.jspdf;
                // Standard A4 portrait sheet with both cards neatly arranged for card cutter / printing
                const pdf = new jsPDF({
                    orientation: "portrait",
                    unit: "mm",
                    format: "a4"
                });

                // Title and instructions on PDF
                pdf.setFont("helvetica", "bold");
                pdf.setFontSize(14);
                pdf.setTextColor(27, 94, 32);
                pdf.text("Mendera Qoci Kebele Administration - Official ID Card", 20, 20);

                pdf.setFont("helvetica", "normal");
                pdf.setFontSize(10);
                pdf.setTextColor(100, 100, 100);
                pdf.text(`Resident: @resident?.FullName | Kebele ID: @Model.IdNumber | Expiry: @Model.ExpiryDate.ToString("yyyy-MM-dd")`, 20, 27);
                pdf.text("Standard ID-1 Format (85.60 mm x 53.98 mm) - Ready for PVC Card Printer or Heavy Paper Stock", 20, 33);

                // Cutting guidelines box for Front
                pdf.setDrawColor(200, 200, 200);
                pdf.setLineDashPattern([2, 2], 0);

                // Add Front Image
                const frontImgData = frontCanvas.toDataURL("image/png");
                const posXFront = 20;
                const posYFront = 45;
                pdf.addImage(frontImgData, "PNG", posXFront, posYFront, cardWidthMm, cardHeightMm);
                pdf.roundedRect(posXFront - 0.5, posYFront - 0.5, cardWidthMm + 1, cardHeightMm + 1, 3, 3, "S");

                pdf.setFontSize(8);
                pdf.setTextColor(120, 120, 120);
                pdf.text("[ Front Side - Cut along border ]", posXFront + 15, posYFront + cardHeightMm + 6);

                // Add Back Image
                const backImgData = backCanvas.toDataURL("image/png");
                const posXBack = 20;
                const posYBack = posYFront + cardHeightMm + 16;
                pdf.addImage(backImgData, "PNG", posXBack, posYBack, cardWidthMm, cardHeightMm);
                pdf.roundedRect(posXBack - 0.5, posYBack - 0.5, cardWidthMm + 1, cardHeightMm + 1, 3, 3, "S");

                pdf.text("[ Back Side - Cut along border / Duplex aligned ]", posXBack + 15, posYBack + cardHeightMm + 6);

                // Footer note
                pdf.setFontSize(8);
                pdf.setTextColor(150, 150, 150);
                pdf.text("Generated by Mendera Qoci Digital File Management System (DFMS) - Jimma, Ethiopia", 20, 280);

                pdf.save(`Kebele_ID_@Model.IdNumber.Replace("/", "_")` + ".pdf");
            } catch (err) {
                alert("Failed to generate PDF: " + err.message);
            } finally {
                if (frontWasHidden) frontCard.style.display = "none";
                if (backWasHidden) backCard.style.display = "none";
            }
        });
    </script>
}
