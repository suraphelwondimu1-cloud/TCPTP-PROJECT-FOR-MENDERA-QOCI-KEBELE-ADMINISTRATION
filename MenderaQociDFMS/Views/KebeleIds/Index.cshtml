@model IEnumerable<MenderaQociDFMS.Models.KebeleIdRecord>
@{
    ViewData["Title"] = "Kebele ID Records";
}

<div class="d-flex justify-content-between align-items-center kebele-header">
    <div>
        <h3 class="fw-bold text-success mb-0"><i class="bi bi-card-heading me-2"></i>Kebele ID Management</h3>
        <span class="text-muted small">Manage resident identification records & renewals</span>
    </div>
    <a asp-action="Create" class="btn btn-kebele"><i class="bi bi-card-plus me-1"></i> Issue New Kebele ID</a>
</div>

<!-- Search & Filter Bar -->
<div class="card border-0 shadow-sm mb-4">
    <div class="card-body py-3">
        <form method="get" asp-action="Index" class="row g-2 align-items-center">
            <div class="col-md-5">
                <input type="text" name="searchNumber" value="@ViewBag.SearchNumber" class="form-control" placeholder="Search by ID Number or Resident Name..." />
            </div>
            <div class="col-md-4">
                <select name="status" class="form-select">
                    <option value="">-- All Statuses --</option>
                    <option value="Active" selected="@(ViewBag.Status == "Active")">Active</option>
                    <option value="ExpiringSoon" selected="@(ViewBag.Status == "ExpiringSoon")">Expiring Soon (Within 30 Days)</option>
                    <option value="Expired" selected="@(ViewBag.Status == "Expired")">Expired</option>
                    <option value="Cancelled" selected="@(ViewBag.Status == "Cancelled")">Cancelled</option>
                </select>
            </div>
            <div class="col-md-3 d-flex gap-1">
                <button type="submit" class="btn btn-success w-100"><i class="bi bi-search me-1"></i> Filter</button>
                <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-counterclockwise"></i></a>
            </div>
        </form>
    </div>
</div>

<!-- Kebele IDs Table -->
<div class="card border-0 shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>ID Number</th>
                    <th>Resident Name</th>
                    <th>Sub-Kebele</th>
                    <th>Issue Date</th>
                    <th>Expiry Date</th>
                    <th>Status</th>
                    <th>Remarks</th>
                    <th class="text-center">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="8" class="text-center py-4 text-muted">No Kebele ID records found.</td>
                    </tr>
                }
                else
                {
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="fw-bold text-success">@item.IdNumber</td>
                            <td class="fw-semibold">
                                <a asp-controller="Residents" asp-action="Details" asp-route-id="@item.ResidentId" class="text-decoration-none">@item.Resident?.FullName</a>
                            </td>
                            <td>@item.Resident?.SubKebele?.SubKebeleName</td>
                            <td>@item.IssueDate.ToString("yyyy-MM-dd")</td>
                            <td>@item.ExpiryDate.ToString("yyyy-MM-dd")</td>
                            <td>
                                @if (item.IdStatus == "Active" && item.ExpiryDate >= DateTime.Now)
                                {
                                    <span class="badge bg-success">Active</span>
                                }
                                else if (item.ExpiryDate < DateTime.Now || item.IdStatus == "Expired")
                                {
                                    <span class="badge bg-warning text-dark">Expired</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">@item.IdStatus</span>
                                }
                            </td>
                            <td class="small text-muted">@(item.Remarks ?? "-")</td>
                            <td class="text-center">
                                <div class="btn-group btn-group-sm">
                                    <a asp-action="CardPreview" asp-route-id="@item.IdRecordId" class="btn btn-outline-success" title="Preview ID Card"><i class="bi bi-person-badge"></i> Card</a>
                                    <a asp-action="Details" asp-route-id="@item.IdRecordId" class="btn btn-outline-primary"><i class="bi bi-eye"></i> Details</a>
                                    @if (item.IdStatus == "Active")
                                    {
                                        <a asp-action="Renew" asp-route-id="@item.IdRecordId" class="btn btn-outline-warning"><i class="bi bi-arrow-repeat"></i> Renew</a>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Pagination -->
@if (ViewBag.TotalPages > 1)
{
    <nav class="mt-3">
        <ul class="pagination justify-content-center">
            @for (int i = 1; i <= ViewBag.TotalPages; i++)
            {
                <li class="page-item @(i == ViewBag.CurrentPage ? "active" : "")">
                    <a class="page-link" asp-action="Index" asp-route-page="@i" asp-route-searchNumber="@ViewBag.SearchNumber" asp-route-status="@ViewBag.Status">@i</a>
                </li>
            }
        </ul>
    </nav>
}
