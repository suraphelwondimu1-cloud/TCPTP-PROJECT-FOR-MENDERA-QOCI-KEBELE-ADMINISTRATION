@{
    ViewData["Title"] = "Access Denied";
}

<div class="row justify-content-center my-5">
    <div class="col-md-6 text-center">
        <div class="card border-0 shadow-sm p-4">
            <div class="text-danger mb-3">
                <i class="bi bi-shield-x fs-1"></i>
            </div>
            <h4 class="fw-bold text-danger">Access Denied</h4>
            <p class="text-muted">You do not have administrative privileges to access this area of the system.</p>
            <div>
                <a asp-controller="Dashboard" asp-action="Index" class="btn btn-success"><i class="bi bi-house me-1"></i> Return to Dashboard</a>
            </div>
        </div>
    </div>
</div>
