@model IEnumerable<MenderaQociDFMS.Models.Resident>
@{
    ViewData["Title"] = "Residents List";
}

<div class="d-flex justify-content-between align-items-center kebele-header">
    <div>
        <h3 class="fw-bold text-success mb-0"><i class="bi bi-people me-2"></i>Resident Records</h3>
        <span class="text-muted small">Manage resident registration profiles</span>
    </div>
    <a asp-action="Create" class="btn btn-kebele"><i class="bi bi-person-plus me-1"></i> Register New Resident</a>
</div>

<!-- Search & Filter Card -->
<div class="card border-0 shadow-sm mb-4">
    <div class="card-body py-3">
        <form method="get" asp-action="Index" class="row g-2 align-items-center">
            <div class="col-md-4">
                <input type="text" name="searchString" value="@ViewBag.SearchString" class="form-control" placeholder="Search by name, phone, or resident ID..." />
            </div>
            <div class="col-md-3">
                <select name="subKebeleId" asp-items="ViewBag.SubKebeles" class="form-select">
                    <option value="">-- All Sub-Kebeles --</option>
                </select>
            </div>
            <div class="col-md-3">
                <select name="status" class="form-select">
                    <option value="">-- All Statuses --</option>
                    <option value="Active" selected="@(ViewBag.Status == "Active")">Active</option>
                    <option value="Inactive" selected="@(ViewBag.Status == "Inactive")">Inactive</option>
                </select>
            </div>
            <div class="col-md-2 d-flex gap-1">
                <button type="submit" class="btn btn-success w-100"><i class="bi bi-search me-1"></i> Filter</button>
                <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-counterclockwise"></i></a>
            </div>
        </form>
    </div>
</div>

<!-- Residents Table -->
<div class="card border-0 shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Res ID</th>
                    <th>Full Name</th>
                    <th>Gender</th>
                    <th>Date of Birth</th>
                    <th>Phone Number</th>
                    <th>Sub-Kebele</th>
                    <th>Household Head</th>
                    <th>Status</th>
                    <th class="text-center">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="9" class="text-center py-4 text-muted">No resident records found.</td>
                    </tr>
                }
                else
                {
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td><span class="badge bg-light text-dark border">#@item.ResidentId</span></td>
                            <td class="fw-bold">@item.FullName</td>
                            <td>@item.Gender</td>
                            <td>@item.DateOfBirth.ToString("yyyy-MM-dd")</td>
                            <td>@(item.PhoneNumber ?? "-")</td>
                            <td>@item.SubKebele?.SubKebeleName</td>
                            <td>@(item.HouseholdHead ?? "-")</td>
                            <td>
                                @if (item.Status == "Active")
                                {
                                    <span class="badge bg-success">Active</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">@item.Status</span>
                                }
                            </td>
                            <td class="text-center">
                                <div class="btn-group btn-group-sm">
                                    <a asp-action="Details" asp-route-id="@item.ResidentId" class="btn btn-outline-primary" title="View Details"><i class="bi bi-eye"></i> Details</a>
                                    <a asp-action="Edit" asp-route-id="@item.ResidentId" class="btn btn-outline-secondary" title="Edit Profile"><i class="bi bi-pencil"></i> Edit</a>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Pagination -->
@if (ViewBag.TotalPages > 1)
{
    <nav class="mt-3">
        <ul class="pagination justify-content-center">
            @for (int i = 1; i <= ViewBag.TotalPages; i++)
            {
                <li class="page-item @(i == ViewBag.CurrentPage ? "active" : "")">
                    <a class="page-link" asp-action="Index" asp-route-page="@i" asp-route-searchString="@ViewBag.SearchString" asp-route-subKebeleId="@ViewBag.SubKebeleId" asp-route-status="@ViewBag.Status">@i</a>
                </li>
            }
        </ul>
    </nav>
}
