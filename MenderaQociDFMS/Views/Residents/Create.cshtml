@model MenderaQociDFMS.Models.Resident
@{
    ViewData["Title"] = "Register Resident";
}

<div class="row justify-content-center">
    <div class="col-md-9">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-success text-white py-3">
                <h5 class="fw-bold mb-0"><i class="bi bi-person-plus me-2"></i>New Resident Registration Form</h5>
            </div>
            <div class="card-body p-4">
                <form asp-action="Create" method="post" enctype="multipart/form-data" id="residentForm">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small mb-3"></div>

                    <!-- Photo Capture / Upload Section -->
                    <div class="card bg-light border mb-4">
                        <div class="card-body">
                            <h6 class="fw-bold text-success mb-3"><i class="bi bi-camera me-2"></i>Resident Profile Photo (Upload or Live Camera Capture)</h6>
                            <div class="row align-items-center">
                                <div class="col-md-4 text-center mb-3 mb-md-0">
                                    <div class="position-relative d-inline-block">
                                        <img id="photoPreview" src="data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='160' height='200' viewBox='0 0 160 200'><rect width='160' height='200' fill='%23e9ecef'/><text x='50%25' y='50%25' font-family='sans-serif' font-size='14' fill='%236c757d' text-anchor='middle' dy='.3em'>No Photo</text></svg>"
                                             alt="Preview" class="border rounded shadow-sm" style="width: 150px; height: 180px; object-fit: cover; background: #fff;" />
                                        <button type="button" id="btnRemovePhoto" class="btn btn-danger btn-sm position-absolute top-0 end-0 rounded-circle p-1 d-none" title="Remove photo" style="transform: translate(30%, -30%);">
                                            <i class="bi bi-x-lg"></i>
                                        </button>
                                    </div>
                                    <div class="small text-muted mt-2">Recommended: Passport/ID aspect ratio (3:4 or 4:5)</div>
                                </div>
                                <div class="col-md-8">
                                    <ul class="nav nav-pills mb-3" id="photoTab" role="tablist">
                                        <li class="nav-item" role="presentation">
                                            <button class="nav-link active btn-sm" id="upload-tab" data-bs-toggle="pill" data-bs-target="#tab-upload" type="button" role="tab">
                                                <i class="bi bi-upload me-1"></i> Upload from Computer
                                            </button>
                                        </li>
                                        <li class="nav-item" role="presentation">
                                            <button class="nav-link btn-sm" id="camera-tab" data-bs-toggle="pill" data-bs-target="#tab-camera" type="button" role="tab">
                                                <i class="bi bi-webcam me-1"></i> USB Camera / Webcam
                                            </button>
                                        </li>
                                    </ul>

                                    <div class="tab-content" id="photoTabContent">
                                        <!-- File Upload Tab -->
                                        <div class="tab-pane fade show active" id="tab-upload" role="tabpanel">
                                            <div class="mb-2">
                                                <label class="form-label small fw-semibold">Select image file (JPG, PNG, WEBP - Max 10MB)</label>
                                                <input type="file" name="photoFile" id="photoFileInput" class="form-control" accept="image/*" />
                                            </div>
                                            <p class="text-muted small mb-0">Select a clear portrait photo of the resident from local storage.</p>
                                        </div>

                                        <!-- Camera Capture Tab -->
                                        <div class="tab-pane fade" id="tab-camera" role="tabpanel">
                                            <div id="cameraAlert" class="alert alert-warning py-1 small d-none"></div>

                                            <div class="row g-2 mb-2 align-items-center">
                                                <div class="col-sm-7">
                                                    <select id="cameraSelect" class="form-select form-select-sm">
                                                        <option value="">Default Camera</option>
                                                    </select>
                                                </div>
                                                <div class="col-sm-5 d-flex gap-1">
                                                    <button type="button" id="btnStartCamera" class="btn btn-primary btn-sm flex-fill">
                                                        <i class="bi bi-camera-video me-1"></i> Start Camera
                                                    </button>
                                                    <button type="button" id="btnStopCamera" class="btn btn-secondary btn-sm d-none">
                                                        <i class="bi bi-camera-video-off"></i>
                                                    </button>
                                                </div>
                                            </div>

                                            <div id="videoContainer" class="position-relative d-none mb-2 border rounded overflow-hidden" style="max-width: 320px; background: #000;">
                                                <video id="webcamVideo" autoplay playsinline style="width: 100%; height: auto; transform: scaleX(1);"></video>
                                                <!-- Passport framing overlay guide -->
                                                <div style="position: absolute; top: 10%; left: 20%; width: 60%; height: 80%; border: 2px dashed rgba(255,255,255,0.7); border-radius: 8px; pointer-events: none;"></div>
                                                <div class="text-center p-2 bg-dark bg-opacity-75">
                                                    <button type="button" id="btnCapturePhoto" class="btn btn-warning btn-sm fw-bold">
                                                        <i class="bi bi-camera me-1"></i> Capture Photo
                                                    </button>
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Hidden field to hold base64 camera photo -->
                                    <input type="hidden" name="photoDataUrl" id="photoDataUrl" value="" />
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Resident Demographics Fields -->
                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label asp-for="FirstName" class="form-label fw-semibold"></label>
                            <input asp-for="FirstName" class="form-control" placeholder="Enter first name" />
                            <span asp-validation-for="FirstName" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="LastName" class="form-label fw-semibold"></label>
                            <input asp-for="LastName" class="form-control" placeholder="Enter last name" />
                            <span asp-validation-for="LastName" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label asp-for="DateOfBirth" class="form-label fw-semibold"></label>
                            <input asp-for="DateOfBirth" class="form-control" type="date" />
                            <span asp-validation-for="DateOfBirth" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Gender" class="form-label fw-semibold"></label>
                            <select asp-for="Gender" class="form-select">
                                <option value="">-- Select Gender --</option>
                                <option value="Male">Male</option>
                                <option value="Female">Female</option>
                            </select>
                            <span asp-validation-for="Gender" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label asp-for="PhoneNumber" class="form-label fw-semibold"></label>
                            <input asp-for="PhoneNumber" class="form-control" placeholder="e.g. 0911223344" />
                            <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="SubKebeleId" class="form-label fw-semibold"></label>
                            <select asp-for="SubKebeleId" asp-items="ViewBag.SubKebeleId" class="form-select">
                                <option value="">-- Select Sub-Kebele --</option>
                            </select>
                            <span asp-validation-for="SubKebeleId" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <label asp-for="HouseholdHead" class="form-label fw-semibold"></label>
                            <input asp-for="HouseholdHead" class="form-control" placeholder="Full name of household head" />
                            <span asp-validation-for="HouseholdHead" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Status" class="form-label fw-semibold"></label>
                            <select asp-for="Status" class="form-select">
                                <option value="Active">Active Resident</option>
                                <option value="Inactive">Inactive / Transferred</option>
                            </select>
                        </div>
                    </div>

                    <div class="d-flex justify-content-between pt-3 border-top">
                        <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left me-1"></i> Back to List</a>
                        <button type="submit" class="btn btn-success fw-semibold"><i class="bi bi-check-circle me-1"></i> Save Resident Profile</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        const photoFileInput = document.getElementById('photoFileInput');
        const photoPreview = document.getElementById('photoPreview');
        const photoDataUrl = document.getElementById('photoDataUrl');
        const btnRemovePhoto = document.getElementById('btnRemovePhoto');
        const defaultPlaceholder = photoPreview.src;

        const btnStartCamera = document.getElementById('btnStartCamera');
        const btnStopCamera = document.getElementById('btnStopCamera');
        const btnCapturePhoto = document.getElementById('btnCapturePhoto');
        const cameraSelect = document.getElementById('cameraSelect');
        const webcamVideo = document.getElementById('webcamVideo');
        const videoContainer = document.getElementById('videoContainer');
        const cameraAlert = document.getElementById('cameraAlert');

        let currentStream = null;

        // 1. File Upload handling
        photoFileInput.addEventListener('change', function(e) {
            const file = e.target.files[0];
            if (file) {
                if (file.size > 10 * 1024 * 1024) {
                    alert('Photo size exceeds 10MB limit.');
                    photoFileInput.value = '';
                    return;
                }
                const reader = new FileReader();
                reader.onload = function(evt) {
                    photoPreview.src = evt.target.result;
                    photoDataUrl.value = ''; // file input takes precedence
                    btnRemovePhoto.classList.remove('d-none');
                };
                reader.readAsDataURL(file);
            }
        });

        // 2. Remove photo button
        btnRemovePhoto.addEventListener('click', function() {
            photoPreview.src = defaultPlaceholder;
            photoFileInput.value = '';
            photoDataUrl.value = '';
            btnRemovePhoto.classList.add('d-none');
        });

        // 3. Populate Camera List
        async function getCameras() {
            try {
                if (!navigator.mediaDevices || !navigator.mediaDevices.enumerateDevices) {
                    cameraAlert.textContent = "Camera API not supported in this browser or requires HTTPS/localhost.";
                    cameraAlert.classList.remove('d-none');
                    return;
                }
                const devices = await navigator.mediaDevices.enumerateDevices();
                const videoDevices = devices.filter(d => d.kind === 'videoinput');
                cameraSelect.innerHTML = '';
                if (videoDevices.length === 0) {
                    cameraSelect.innerHTML = '<option value="">No cameras found</option>';
                    return;
                }
                videoDevices.forEach((device, index) => {
                    const option = document.createElement('option');
                    option.value = device.deviceId;
                    option.text = device.label || `Camera ${index + 1}`;
                    cameraSelect.appendChild(option);
                });
            } catch (err) {
                console.error("Camera enumerate error:", err);
            }
        }

        // Initialize camera list on tab click
        document.getElementById('camera-tab').addEventListener('shown.bs.tab', function() {
            getCameras();
        });

        // 4. Start Camera
        btnStartCamera.addEventListener('click', async function() {
            stopCamera();
            cameraAlert.classList.add('d-none');

            const deviceId = cameraSelect.value;
            const constraints = {
                video: {
                    deviceId: deviceId ? { exact: deviceId } : undefined,
                    width: { ideal: 1280 },
                    height: { ideal: 720 },
                    facingMode: "user"
                }
            };

            try {
                currentStream = await navigator.mediaDevices.getUserMedia(constraints);
                webcamVideo.srcObject = currentStream;
                videoContainer.classList.remove('d-none');
                btnStartCamera.classList.add('d-none');
                btnStopCamera.classList.remove('d-none');
                // Re-enumerate to get labels if permissions were just granted
                getCameras();
            } catch (err) {
                console.error("Camera access error:", err);
                cameraAlert.classList.remove('d-none');
                if (err.name === 'NotAllowedError' || err.name === 'PermissionDeniedError') {
                    cameraAlert.textContent = "Camera permission was denied. Please allow camera access in browser settings.";
                } else if (err.name === 'NotFoundError' || err.name === 'DevicesNotFoundError') {
                    cameraAlert.textContent = "No camera hardware detected. Please connect an external USB webcam.";
                } else if (err.name === 'NotReadableError' || err.name === 'TrackStartError') {
                    cameraAlert.textContent = "Camera is currently used by another application.";
                } else {
                    cameraAlert.textContent = "Failed to access camera: " + (err.message || err.name);
                }
            }
        });

        // 5. Stop Camera
        function stopCamera() {
            if (currentStream) {
                currentStream.getTracks().forEach(track => track.stop());
                currentStream = null;
            }
            if (webcamVideo.srcObject) {
                webcamVideo.srcObject = null;
            }
            videoContainer.classList.add('d-none');
            btnStartCamera.classList.remove('d-none');
            btnStopCamera.classList.add('d-none');
        }

        btnStopCamera.addEventListener('click', stopCamera);

        // When switching tabs away from camera, turn off webcam to save resources
        document.getElementById('upload-tab').addEventListener('shown.bs.tab', function() {
            stopCamera();
        });

        // 6. Capture Photo from Video stream
        btnCapturePhoto.addEventListener('click', function() {
            if (!webcamVideo.videoWidth) return;

            const canvas = document.createElement('canvas');
            // Crop to passport standard aspect ratio (3:4)
            const vw = webcamVideo.videoWidth;
            const vh = webcamVideo.videoHeight;
            let cropWidth = vw;
            let cropHeight = Math.round(vw * 4 / 3);

            if (cropHeight > vh) {
                cropHeight = vh;
                cropWidth = Math.round(vh * 3 / 4);
            }

            canvas.width = 480;
            canvas.height = 640;
            const ctx = canvas.getContext('2d');

            const startX = (vw - cropWidth) / 2;
            const startY = (vh - cropHeight) / 2;

            ctx.drawImage(webcamVideo, startX, startY, cropWidth, cropHeight, 0, 0, 480, 640);

            const dataUrl = canvas.toDataURL('image/jpeg', 0.92);
            photoPreview.src = dataUrl;
            photoDataUrl.value = dataUrl;
            photoFileInput.value = ''; // clear file input
            btnRemovePhoto.classList.remove('d-none');

            // Optionally stop camera after capture
            stopCamera();
        });

        // Cleanup stream when navigating away
        window.addEventListener('beforeunload', stopCamera);
    </script>
}
