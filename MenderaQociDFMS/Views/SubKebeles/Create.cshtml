@model MenderaQociDFMS.Models.SubKebele
@{
    ViewData["Title"] = "Add Sub-Kebele";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-success text-white py-3">
                <h5 class="fw-bold mb-0"><i class="bi bi-geo-alt me-2"></i>Add Sub-Kebele Jurisdiction</h5>
            </div>
            <div class="card-body p-4">
                <form asp-action="Create" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="SubKebeleName" class="form-label fw-semibold"></label>
                        <input asp-for="SubKebeleName" class="form-control" placeholder="e.g. Sub-Kebele 05 (South-West)" />
                        <span asp-validation-for="SubKebeleName" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Description" class="form-label fw-semibold"></label>
                        <textarea asp-for="Description" class="form-control" rows="3" placeholder="Brief zone description..."></textarea>
                        <span asp-validation-for="Description" class="text-danger small"></span>
                    </div>

                    <div class="mb-4 form-check">
                        <input asp-for="IsActive" class="form-check-input" checked />
                        <label asp-for="IsActive" class="form-check-label fw-semibold">Active Sub-Kebele</label>
                    </div>

                    <div class="d-flex justify-content-between pt-3 border-top">
                        <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left me-1"></i> Cancel</a>
                        <button type="submit" class="btn btn-success fw-semibold"><i class="bi bi-check-circle me-1"></i> Save Sub-Kebele</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
