@model IEnumerable<MenderaQociDFMS.Models.SubKebele>
@{
    ViewData["Title"] = "Sub-Kebele Setup";
}

<div class="d-flex justify-content-between align-items-center kebele-header">
    <div>
        <h3 class="fw-bold text-success mb-0"><i class="bi bi-geo-alt me-2"></i>Sub-Kebele Jurisdictions</h3>
        <span class="text-muted small">Manage internal kebele zones and community divisions</span>
    </div>
    <a asp-action="Create" class="btn btn-kebele"><i class="bi bi-plus-lg me-1"></i> Add Sub-Kebele</a>
</div>

<div class="card border-0 shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>ID</th>
                    <th>Sub-Kebele Name</th>
                    <th>Description</th>
                    <th>Assigned Residents</th>
                    <th>Status</th>
                    <th class="text-center">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var sk in Model)
                {
                    <tr>
                        <td><span class="badge bg-light text-dark border">#@sk.SubKebeleId</span></td>
                        <td class="fw-bold text-success">@sk.SubKebeleName</td>
                        <td class="small text-muted">@(sk.Description ?? "-")</td>
                        <td><span class="badge bg-primary rounded-pill">@sk.Residents.Count residents</span></td>
                        <td>
                            @if (sk.IsActive)
                            {
                                <span class="badge bg-success">Active</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Inactive</span>
                            }
                        </td>
                        <td class="text-center">
                            <div class="btn-group btn-group-sm">
                                <a asp-action="Edit" asp-route-id="@sk.SubKebeleId" class="btn btn-outline-primary"><i class="bi bi-pencil"></i> Edit</a>
                                <form asp-action="Delete" asp-route-id="@sk.SubKebeleId" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to delete this Sub-Kebele?');">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-outline-danger" @(sk.Residents.Any() ? "disabled title='Cannot delete while residents are assigned'" : "")>
                                        <i class="bi bi-trash"></i> Delete
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
