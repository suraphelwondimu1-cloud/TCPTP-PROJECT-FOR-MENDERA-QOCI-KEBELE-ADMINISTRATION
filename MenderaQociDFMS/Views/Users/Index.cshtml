@model IEnumerable<MenderaQociDFMS.ViewModels.UserListViewModel>
@{
    ViewData["Title"] = "Staff Accounts Management";
}

<div class="d-flex justify-content-between align-items-center kebele-header">
    <div>
        <h3 class="fw-bold text-success mb-0"><i class="bi bi-person-gear me-2"></i>Kebele Staff Accounts</h3>
        <span class="text-muted small">Manage user access credentials and authorization roles</span>
    </div>
    <a asp-action="Create" class="btn btn-kebele"><i class="bi bi-person-plus me-1"></i> Create Staff Account</a>
</div>

<div class="card border-0 shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Username</th>
                    <th>Full Name</th>
                    <th>Role</th>
                    <th>Account Status</th>
                    <th>Created On</th>
                    <th class="text-center">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var user in Model)
                {
                    <tr>
                        <td class="fw-bold text-success">@user.UserName</td>
                        <td class="fw-semibold">@user.FullName</td>
                        <td>
                            @if (user.Role == "Admin")
                            {
                                <span class="badge bg-warning text-dark">Administrator</span>
                            }
                            else
                            {
                                <span class="badge bg-info text-dark">Staff</span>
                            }
                        </td>
                        <td>
                            @if (user.IsActive)
                            {
                                <span class="badge bg-success">Active</span>
                            }
                            else
                            {
                                <span class="badge bg-danger">Deactivated</span>
                            }
                        </td>
                        <td>@user.CreatedAt.ToString("yyyy-MM-dd")</td>
                        <td class="text-center">
                            <div class="btn-group btn-group-sm">
                                <a asp-action="Edit" asp-route-id="@user.Id" class="btn btn-outline-primary"><i class="bi bi-pencil"></i> Edit</a>
                                <form asp-action="ToggleStatus" asp-route-id="@user.Id" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn @(user.IsActive ? "btn-outline-danger" : "btn-outline-success")">
                                        @(user.IsActive ? "Deactivate" : "Activate")
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
