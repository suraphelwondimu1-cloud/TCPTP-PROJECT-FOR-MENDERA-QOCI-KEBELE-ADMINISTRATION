@model MenderaQociDFMS.Models.Correspondence
@{
    ViewData["Title"] = $"Correspondence Details - {Model.ReferenceNumber}";
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-success text-white d-flex justify-content-between align-items-center py-3">
                <h5 class="fw-bold mb-0"><i class="bi bi-file-earmark-text me-2"></i>Correspondence Record: @Model.ReferenceNumber</h5>
                <button onclick="window.print()" class="btn btn-outline-light btn-sm no-print"><i class="bi bi-printer me-1"></i> Print Document Record</button>
            </div>
            <div class="card-body p-4">
                <div class="border rounded p-3 bg-light mb-4 text-center">
                    <h6 class="text-uppercase fw-bold text-success mb-1">Mendera Qoci Kebele Administration Office, Jimma</h6>
                    <h5 class="fw-bold mb-0">OFFICIAL CORRESPONDENCE / ISSUED DOCUMENT ARCHIVE</h5>
                </div>

                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="text-muted small">Reference Number:</label>
                        <h5 class="fw-bold text-success">@Model.ReferenceNumber</h5>
                    </div>
                    <div class="col-md-6">
                        <label class="text-muted small">Document Type:</label>
                        <div>
                            <span class="badge bg-light text-dark border fs-6">@Model.DocumentType</span>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <label class="text-muted small">Resident Holder Name:</label>
                        <p class="fw-semibold mb-0">
                            <a asp-controller="Residents" asp-action="Details" asp-route-id="@Model.ResidentId" class="text-decoration-none">@Model.Resident?.FullName</a>
                        </p>
                    </div>
                    <div class="col-md-6">
                        <label class="text-muted small">Sub-Kebele:</label>
                        <p class="fw-semibold mb-0">@Model.Resident?.SubKebele?.SubKebeleName</p>
                    </div>
                    <div class="col-md-6">
                        <label class="text-muted small">Issue Date:</label>
                        <p class="fw-semibold mb-0">@Model.IssueDate.ToString("yyyy-MM-dd")</p>
                    </div>
                    <div class="col-md-6">
                        <label class="text-muted small">Issued By Staff:</label>
                        <p class="fw-semibold mb-0">@(Model.IssuedByUser?.FullName ?? "Staff Officer")</p>
                    </div>
                    <div class="col-md-12">
                        <label class="text-muted small">Stated Purpose & Description:</label>
                        <div class="p-3 border rounded bg-white">
                            @Model.Purpose
                        </div>
                    </div>
                </div>

                <div class="d-flex justify-content-between pt-4 mt-4 border-top no-print">
                    <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left me-1"></i> Back to Correspondence List</a>
                </div>
            </div>
        </div>
    </div>
</div>
