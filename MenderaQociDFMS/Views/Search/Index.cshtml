@model IEnumerable<MenderaQociDFMS.Models.Resident>
@{
    ViewData["Title"] = "Search & Retrieval";
}

<div class="d-flex justify-content-between align-items-center kebele-header">
    <div>
        <h3 class="fw-bold text-success mb-0"><i class="bi bi-search me-2"></i>Resident & File Search Engine</h3>
        <span class="text-muted small">Search by Resident Name, Kebele ID Number, Phone, Sub-Kebele, or Document Reference</span>
    </div>
</div>

<!-- Search Input Card -->
<div class="card border-0 shadow-sm mb-4">
    <div class="card-body p-4">
        <form method="get" asp-action="Index" class="row g-2">
            <div class="col-md-10">
                <div class="input-group input-group-lg">
                    <span class="input-group-text bg-white"><i class="bi bi-search text-success"></i></span>
                    <input type="text" name="q" value="@ViewBag.Query" class="form-control" placeholder="Type resident name, ID number (e.g. KID-MQ-2024-001), phone, or Sub-Kebele..." autofocus />
                </div>
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-success btn-lg w-100 fw-semibold"><i class="bi bi-search me-1"></i> Search</button>
            </div>
        </form>
    </div>
</div>

<!-- Search Results -->
@if (ViewBag.Query != null)
{
    <div class="mb-3">
        <h6 class="text-muted">Search Results for "<span class="text-dark fw-bold">@ViewBag.Query</span>" (@Model.Count() records found):</h6>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Res ID</th>
                        <th>Full Name</th>
                        <th>Gender</th>
                        <th>Sub-Kebele</th>
                        <th>Phone</th>
                        <th>Active Kebele ID</th>
                        <th>Total Correspondences</th>
                        <th class="text-center">Action</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="8" class="text-center py-4 text-muted">
                                <i class="bi bi-exclamation-circle fs-3 text-warning d-block mb-2"></i>
                                No matching records found for query "<strong>@ViewBag.Query</strong>".
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var res in Model)
                        {
                            var activeId = res.KebeleIdRecords.FirstOrDefault(k => k.IdStatus == "Active" && k.ExpiryDate >= DateTime.Now);
                            <tr>
                                <td><span class="badge bg-light text-dark border">#@res.ResidentId</span></td>
                                <td class="fw-bold">@res.FullName</td>
                                <td>@res.Gender</td>
                                <td>@res.SubKebele?.SubKebeleName</td>
                                <td>@(res.PhoneNumber ?? "-")</td>
                                <td>
                                    @if (activeId != null)
                                    {
                                        <span class="badge bg-success">@activeId.IdNumber</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">No Active ID</span>
                                    }
                                </td>
                                <td><span class="badge bg-info text-dark">@res.Correspondences.Count documents</span></td>
                                <td class="text-center">
                                    <a asp-controller="Residents" asp-action="Details" asp-route-id="@res.ResidentId" class="btn btn-sm btn-primary"><i class="bi bi-folder2-open me-1"></i> Open Profile</a>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
}
